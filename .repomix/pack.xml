<file path=".github/actions/licenses-audit/src/licenses-report.ts">
/**
 * Generate a deterministic, SPDX-grouped license report from the installed
 * dependency tree. Bundled into the `licenses-audit` action and run against the
 * consumer's checkout (cwd = repo root) after the action installs dependencies.
 *
 * Package-manager-agnostic: it walks `node_modules` and reads each package's
 * declared `license`/`licenses` field, so the report is identical whether
 * dependencies were installed by pnpm, npm, or bun. It shells out to no package
 * manager, has zero runtime dependencies, and never touches the network — the
 * output depends only on what a frozen-lockfile install put on disk, so it is
 * stable across machines and CI for a given lockfile (no paths or timestamps).
 *
 * The output path defaults to `LICENSES.md` and is overridable via the
 * `LICENSES_FILE` environment variable (the action passes its `licenses-file`
 * input). Run directly with `bun src/licenses-report.ts`.
 */
import { readdir, readFile, writeFile } from "node:fs/promises";
import { sep } from "node:path";

const nodeModulesDir = "node_modules";
const unknownLicense = "UNKNOWN";
const preamble =
  "> Generated by the licenses-audit action (licenses-report.ts). Do not edit by hand.";

/** A single dependency's resolved license, keyed for de-duplication. */
export interface LicenseRecord {
  name: string;
  version: string;
  license: string;
}

/** Read a property from a value that may not be an object, without asserting its shape. */
function readProperty(value: unknown, key: string): unknown {
  if (typeof value !== "object" || value === null) return undefined;
  return (value as Record<string, unknown>)[key];
}

/** Return the value when it is a non-empty string, else `undefined`. */
function asNonEmptyString(value: unknown): string | undefined {
  return typeof value === "string" && value.length > 0 ? value : undefined;
}

/**
 * Resolve a manifest's declared license to a single display string. Tolerates
 * the SPDX string form, the legacy `{ type }` object, and the legacy
 * `licenses: [{ type }]` array; returns `UNKNOWN` when none is present.
 */
export function normalizeLicense(manifest: unknown): string {
  const license = readProperty(manifest, "license");
  const direct = asNonEmptyString(license);
  if (direct) return direct;
  const legacyType = asNonEmptyString(readProperty(license, "type"));
  if (legacyType) return legacyType;
  const licenses = readProperty(manifest, "licenses");
  if (Array.isArray(licenses)) {
    const types = licenses
      .map((entry) => asNonEmptyString(readProperty(entry, "type")))
      .filter((type): type is string => type !== undefined);
    if (types.length > 0) return types.join(" OR ");
  }
  return unknownLicense;
}

/**
 * True when a `node_modules`-relative path is a package's own manifest —
 * `<pkg>/package.json` or `@scope/<pkg>/package.json`, optionally nested under a
 * deeper `node_modules` (npm hoisting, or the pnpm/bun virtual store). Rejects
 * manifests shipped inside a package's own subtree (test fixtures, bundled
 * examples), which are not installed dependencies.
 */
export function isPackageManifest(relativePath: string): boolean {
  const segments = relativePath.split(sep);
  if (segments.pop() !== "package.json") return false;
  const depth = segments.length;
  if (depth === 0) return false;
  if (depth === 1) return !segments[0].startsWith(".");
  const parent = segments[depth - 2];
  if (depth === 2 && parent.startsWith("@")) return true;
  if (parent === "node_modules") return true;
  return segments[depth - 3] === "node_modules" && parent.startsWith("@");
}

/** Render records as Markdown grouped by license, with both axes sorted. */
export function renderLicensesMarkdown(records: LicenseRecord[]): string {
  const groups = new Map<string, string[]>();
  for (const record of records) {
    const id = `${record.name}@${record.version}`;
    const group = groups.get(record.license);
    if (group) group.push(id);
    else groups.set(record.license, [id]);
  }
  const licenses = [...groups.keys()].sort();
  const sections = licenses.map((license) => {
    const bullets = (groups.get(license) ?? [])
      .slice()
      .sort()
      .map((entry) => `- ${entry}`)
      .join("\n");
    return `## ${license}\n\n${bullets}`;
  });
  const summary = `${records.length} packages across ${licenses.length} licenses.`;
  return `${["# Licenses", preamble, summary, ...sections].join("\n\n")}\n`;
}

/** Parse one manifest leniently; `null` when it is unreadable. */
async function readManifest(path: string): Promise<unknown> {
  try {
    return JSON.parse(await readFile(path, "utf8"));
  } catch (error) {
    const message = error instanceof Error ? error.message : String(error);
    console.warn(`licenses-report: skipping ${path}: ${message}`);
    return null;
  }
}

/**
 * Walk `node_modules` and collect one record per distinct `name@version`,
 * skipping private packages (the consumer's own workspace members and anything
 * not published).
 */
async function collectRecords(directory: string): Promise<LicenseRecord[]> {
  const entries = await readdir(directory, { recursive: true });
  const records = new Map<string, LicenseRecord>();
  for (const entry of entries) {
    if (!isPackageManifest(entry)) continue;
    const manifest = await readManifest(`${directory}${sep}${entry}`);
    if (!manifest) continue;
    const name = asNonEmptyString(readProperty(manifest, "name"));
    const version = asNonEmptyString(readProperty(manifest, "version"));
    if (!name || !version || readProperty(manifest, "private") === true) continue;
    records.set(`${name}@${version}`, { name, version, license: normalizeLicense(manifest) });
  }
  return [...records.values()];
}

async function main(): Promise<void> {
  const outputFile = process.env.LICENSES_FILE ?? "LICENSES.md";
  const records = await collectRecords(nodeModulesDir);
  await writeFile(outputFile, renderLicensesMarkdown(records));
  console.log(`licenses-report: wrote ${outputFile} (${records.length} packages)`);
}

if (import.meta.main) {
  main().catch((error: unknown) => {
    console.error(error);
    process.exit(1);
  });
}
</file>

<file path=".github/actions/licenses-audit/action.yml">
name: Licenses audit
description: Detect the consumer's package manager (pnpm, npm, or bun), install dependencies, and regenerate an SPDX-grouped license report with the action's bundled generator. Auto-commits drift on same-repo PRs and fails fork PRs that ship stale license data. Skips when no lockfile is present.

inputs:
  bot_token:
    description: |
      PAT (classic with `repo`, or fine-grained with `contents: write`) or GitHub App installation token used to check out the PR branch with persisted credentials and push the regenerated license report. The default `GITHUB_TOKEN` is not used: the auto-commit must be authored by and pushed as the bot identity so it carries correct attribution and re-triggers the PR's checks (commits pushed with `GITHUB_TOKEN` do not). Pass the `secrets.BOT_TOKEN` secret. Required: an empty value fails the push with no fallback.
    required: true
  bot_username:
    description: |
      Git author/committer login for the auto-commit. Defaults to `github-actions[bot]` when unset. Pass the `vars.BOT_USERNAME` repository variable to attribute the commit to a dedicated bot identity.
    required: false
    default: ""
  licenses-file:
    description: Path to the generated license report checked for drift.
    required: false
    default: LICENSES.md
  node-version-file:
    description: File `actions/setup-node` reads the Node version from.
    required: false
    default: .nvmrc

outputs:
  skipped:
    description: "`true` when no lockfile was found and the audit was skipped."
    value: ${{ steps.pm.outputs.skip }}
  drifted:
    description: "`true` when the regenerated license report differed from the committed one."
    value: ${{ steps.drift.outputs.drifted }}

runs:
  using: composite
  steps:
    - name: Detect PR origin
      id: src
      shell: bash
      run: |
        if [ "${{ github.event.pull_request.head.repo.full_name }}" = "${{ github.repository }}" ]; then
          echo "same_repo=true" >> "$GITHUB_OUTPUT"
        else
          echo "same_repo=false" >> "$GITHUB_OUTPUT"
        fi

    - name: Checkout PR branch (same-repo; writable)
      if: steps.src.outputs.same_repo == 'true'
      uses: actions/checkout@v7
      with:
        ref: ${{ github.head_ref }}
        fetch-depth: 0
        persist-credentials: true
        token: ${{ inputs.bot_token }}

    - name: Checkout (fork PR; read-only)
      if: steps.src.outputs.same_repo == 'false'
      uses: actions/checkout@v7
      with:
        ref: ${{ github.event.pull_request.head.sha }}
        persist-credentials: false

    - name: Detect package manager
      id: pm
      shell: bash
      run: |
        set -euo pipefail
        if [ -f pnpm-lock.yaml ]; then
          manager=pnpm
        elif [ -f package-lock.json ]; then
          manager=npm
        elif [ -f bun.lock ] || [ -f bun.lockb ]; then
          manager=bun
        else
          echo "::notice::No lockfile (pnpm-lock.yaml, package-lock.json, or bun.lock) found — skipping license audit."
          echo "skip=true" >> "$GITHUB_OUTPUT"
          exit 0
        fi
        {
          echo "skip=false"
          echo "manager=${manager}"
        } >> "$GITHUB_OUTPUT"
        echo "::notice::Detected package manager: ${manager}"

    - name: Setup Node
      if: steps.pm.outputs.skip == 'false'
      uses: actions/setup-node@v7
      with:
        node-version-file: ${{ inputs.node-version-file }}

    - name: Enable Corepack (pnpm)
      if: steps.pm.outputs.skip == 'false' && steps.pm.outputs.manager == 'pnpm'
      shell: bash
      env:
        COREPACK_ENABLE_DOWNLOAD_PROMPT: "0"
      run: corepack enable

    - name: Setup Bun
      if: steps.pm.outputs.skip == 'false'
      uses: oven-sh/setup-bun@v2
      with:
        bun-version: 1.x

    - name: Install dependencies
      if: steps.pm.outputs.skip == 'false'
      shell: bash
      env:
        PACKAGE_MANAGER: ${{ steps.pm.outputs.manager }}
      run: |
        set -euo pipefail
        case "$PACKAGE_MANAGER" in
          pnpm) pnpm install --frozen-lockfile ;;
          npm) npm ci ;;
          bun) bun install --frozen-lockfile ;;
          *) echo "::error::Unsupported package manager: ${PACKAGE_MANAGER}"; exit 1 ;;
        esac

    - name: Regenerate license report
      if: steps.pm.outputs.skip == 'false'
      shell: bash
      env:
        LICENSES_FILE: ${{ inputs.licenses-file }}
      run: bun "${{ github.action_path }}/src/licenses-report.ts"

    - name: Detect drift
      id: drift
      if: steps.pm.outputs.skip == 'false'
      shell: bash
      env:
        LICENSES_FILE: ${{ inputs.licenses-file }}
      run: |
        if git diff --quiet -- "$LICENSES_FILE"; then
          echo "drifted=false" >> "$GITHUB_OUTPUT"
        else
          echo "drifted=true" >> "$GITHUB_OUTPUT"
        fi

    - name: Auto-commit regenerated report (same-repo)
      if: steps.drift.outputs.drifted == 'true' && steps.src.outputs.same_repo == 'true'
      shell: bash
      env:
        LICENSES_FILE: ${{ inputs.licenses-file }}
        BOT_USERNAME: ${{ inputs.bot_username }}
        HEAD_REF: ${{ github.head_ref }}
      run: |
        set -euo pipefail
        git config user.name "${BOT_USERNAME:-github-actions[bot]}"
        git config user.email "${BOT_USERNAME:-41898282+github-actions[bot]}@users.noreply.github.com"
        git add "$LICENSES_FILE"
        git diff --staged --quiet || git commit -m "chore(licenses): regenerate license report"
        git push origin "HEAD:$HEAD_REF"

    - name: Fail (fork PR with drift)
      if: steps.drift.outputs.drifted == 'true' && steps.src.outputs.same_repo == 'false'
      shell: bash
      env:
        LICENSES_FILE: ${{ inputs.licenses-file }}
      run: |
        echo "::error::$LICENSES_FILE is out of date for the updated dependencies. A maintainer will regenerate it after merge, or run the licenses-audit generator and commit the result to this branch."
        git diff -- "$LICENSES_FILE"
        exit 1
</file>

