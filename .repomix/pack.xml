  - MCP(Ref:*)
  - MCP(exa:*)
  - MCP(perplexity:*)
  - Bash(command -v graphify)
  - Bash(graphify *)
  - Bash(command -v entire)
  - Bash(entire *)
  - MCP(repomix:*)
  - MCP(linear:*)
  - ToolSearch
  - AskUserQuestion
