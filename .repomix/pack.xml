  test("allows ANTHROPIC_API_KEY alone", () => {
    const env = buildSdkEnv({ ANTHROPIC_API_KEY: "k" });
    expect(env.ANTHROPIC_API_KEY).toBe("k");
    expect("ANTHROPIC_AUTH_TOKEN" in env).toBe(false);
