{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalDependencies": [".prettierignore", "bun.lock"],
  "globalPassThroughEnv": ["CI", "GITHUB_*", "RUNNER_*", "TURBO_*", "PATH", "HOME", "TMPDIR"],
  "tasks": {
    "typecheck": {
      "inputs": ["action.yml", "*.ts", "src/**/*.ts", "tsconfig.json", "package.json"],
      "outputs": []
    },
    "test": {
      "inputs": [
        "*.ts",
        "src/**/*.ts",
        "tsconfig.json",
        "package.json",
        "$TURBO_ROOT$/claude-plugins/**/*.md",
        "$TURBO_ROOT$/docs/**/*.md",
        "$TURBO_ROOT$/rfc/**/*.md",
        "$TURBO_ROOT$/rules/*.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/CONTRIBUTING.md"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
